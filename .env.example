# FoodPoint environment template — copy to .env.local and fill in

# ── Database (Neon) ─────────────────────────────────────────────
# Neon dashboard → your project → Connect
# Pooled connection (host contains "-pooler") — used by the app
DATABASE_URL=""
# Direct connection (same, without "-pooler") — used for migrations
DIRECT_URL=""

# ── Auth ───────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# ── Images (Cloudinary) ────────────────────────────────────────
# Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Site ───────────────────────────────────────────────────────
# Used to build table QR code links. Change to your real domain when deployed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── First admin (Owner) account created by the seed script ─────
SEED_OWNER_EMAIL="owner@foodpoint.com"
SEED_OWNER_PASSWORD=""
